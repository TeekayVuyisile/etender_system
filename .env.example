# Settings for `docker compose up`. Copy this file to .env (next to docker-compose.yml).
# Every value is optional: without a .env file the stack still runs with local defaults.
# (For running the backend without Docker, use backend/.env.example instead.)

# Port for the app on your machine: http://localhost:8080
WEB_PORT=8080

# Password for the local PostgreSQL container
POSTGRES_PASSWORD=tih-local-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Groq API key for AI summaries (free at https://console.groq.com). Leave empty to run without AI.
GROQ_API_KEY=

# "Try the demo" button with private sample workspaces
DEMO_MODE_ENABLED=false

# How many days of tenders the worker imports on each sync
SYNC_DAYS=7
