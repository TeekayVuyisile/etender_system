# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="Tender Insight Hub"
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (e.g. Neon). Defaults to a local SQLite file if not set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# MongoDB (e.g. MongoDB Atlas)
MONGODB_URL=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=tender_insight_hub

# Redis (optional): caches tender data and shares rate limits between API processes.
# Leave empty to run without it. Local: redis://localhost:6379/0
# Redis Cloud: redis://default:password@host:port (use rediss:// if TLS is enabled)
REDIS_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq LLM (AI summaries). Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Automatic tender sync (alternatively run `python -m app.cli scheduler` as a worker)
SYNC_SCHEDULE_ENABLED=false
SYNC_INTERVAL_HOURS=6
SYNC_DAYS=3

# "Try the demo" button: private sample workspaces, deleted after DEMO_TTL_HOURS.
# Run `python -m app.cli prepare-demo` once so demos include AI summaries.
DEMO_MODE_ENABLED=false
DEMO_TTL_HOURS=24
